{
  "dataRoles": [
    {
      "displayName": "Axis (date or sequence)",
      "name": "axis",
      "kind": "Grouping",
      "description": "Time period or sequence, e.g. Week, Month, Inspection #"
    },
    {
      "displayName": "Value",
      "name": "value",
      "kind": "Measure",
      "description": "The process measure, e.g. Avg report turnaround (days)"
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "axis": {
            "max": 1
          },
          "value": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "axis"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 2000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "value"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "spc": {
      "properties": {
        "baselinePoints": {
          "type": {
            "numeric": true
          }
        },
        "ruleOutside": {
          "type": {
            "bool": true
          }
        },
        "ruleRun": {
          "type": {
            "bool": true
          }
        },
        "runLength": {
          "type": {
            "numeric": true
          }
        },
        "ruleTwoOfThree": {
          "type": {
            "bool": true
          }
        },
        "showZones": {
          "type": {
            "bool": true
          }
        },
        "floorAtZero": {
          "type": {
            "bool": true
          }
        },
        "lineColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "brand": {
      "properties": {
        "primary": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "secondary": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "neutral": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "good": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "warning": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "bad": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "text": {
      "properties": {
        "fontSize": {
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "fontColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "showLabels": {
          "type": {
            "bool": true
          }
        }
      }
    }
  },
  "supportsHighlight": false,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": false,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "privileges": []
}
