{
  "dataRoles": [
    {
      "displayName": "Group / phase (optional)",
      "name": "group",
      "kind": "Grouping",
      "description": "e.g. Phase, Project, Work package"
    },
    {
      "displayName": "Task",
      "name": "task",
      "kind": "Grouping",
      "description": "One bar per task"
    },
    {
      "displayName": "Planned start",
      "name": "start",
      "kind": "Grouping",
      "description": "Baseline start date (pick the field, not 'Date Hierarchy')"
    },
    {
      "displayName": "Planned finish",
      "name": "end",
      "kind": "Grouping",
      "description": "Baseline finish date"
    },
    {
      "displayName": "Actual / forecast start (optional)",
      "name": "actualStart",
      "kind": "Grouping"
    },
    {
      "displayName": "Actual / forecast finish (optional)",
      "name": "actualEnd",
      "kind": "Grouping"
    },
    {
      "displayName": "% complete (optional)",
      "name": "progress",
      "kind": "Measure",
      "description": "0–1 or 0–100"
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "group": {
            "max": 1
          },
          "task": {
            "max": 1
          },
          "start": {
            "max": 1
          },
          "end": {
            "max": 1
          },
          "actualStart": {
            "max": 1
          },
          "actualEnd": {
            "max": 1
          },
          "progress": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "group"
              }
            },
            {
              "for": {
                "in": "task"
              }
            },
            {
              "for": {
                "in": "start"
              }
            },
            {
              "for": {
                "in": "end"
              }
            },
            {
              "for": {
                "in": "actualStart"
              }
            },
            {
              "for": {
                "in": "actualEnd"
              }
            },
            {
              "for": {
                "in": "progress"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 1000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "gantt": {
      "properties": {
        "showToday": {
          "type": {
            "bool": true
          }
        },
        "showSlip": {
          "type": {
            "bool": true
          }
        },
        "slipWarnDays": {
          "type": {
            "numeric": true
          }
        },
        "rowHeight": {
          "type": {
            "numeric": true
          }
        },
        "labelWidth": {
          "type": {
            "numeric": true
          }
        },
        "showGroupSummary": {
          "type": {
            "bool": true
          }
        }
      }
    },
    "brand": {
      "properties": {
        "primary": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "secondary": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "neutral": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "good": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "warning": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "bad": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "text": {
      "properties": {
        "fontSize": {
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "fontColor": {
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "showLabels": {
          "type": {
            "bool": true
          }
        }
      }
    }
  },
  "supportsHighlight": false,
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": false,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "privileges": []
}
